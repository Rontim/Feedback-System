# Copy to .env and adjust. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
SECURE_COOKIES=0

POSTGRES_DB=feedback
POSTGRES_USER=feedback
POSTGRES_PASSWORD=feedback

EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=feedback@companyx.test

# Added in later steps (keep server-side only, never in React)

# Alerts
CARE_ALERT_FALLBACK_EMAIL=care@companyx.test
DASHBOARD_URL=http://localhost:3000/dashboard

# Dashboard days (trend buckets, date filters) use this zone
TIME_ZONE=Africa/Nairobi

# SMS (Africa's Talking). Leave AT_API_KEY empty to run with SMS skipped.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Callback URL: https://<public-host>/api/sms/inbound?token=<this value>. Empty = webhook rejects all.
AT_WEBHOOK_TOKEN=change-me-to-a-long-random-string
DEFAULT_COUNTRY_CODE=254
SMS_MAX_RESPONSES_PER_DAY=5

# AI comment tagging via Google's OpenAI-compatible API
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=20
